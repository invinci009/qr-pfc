# ==============================================================================
# PFC - Patna Fried Chicken — Environment Configuration
# ==============================================================================

# Supabase Configuration (NEW SUPABASE PROJECT)
# 1. Create a new project in Supabase (https://supabase.com/dashboard)
# 2. Get API credentials from: Project Settings -> API
# 3. Run the turnkey migration script in supabase/pfc_setup.sql in the SQL Editor
NEXT_PUBLIC_SUPABASE_URL=https://<NEW_PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-new-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-new-supabase-service-role-key

# App Configuration
APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Cookie (Minimum 32 random characters)
SESSION_COOKIE_SECRET=generate-a-random-32-char-string-here-32chars

# Security (Minimum 32 random characters)
HASH_SALT=generate-another-random-32-char-string-32ch

# Optional: Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: LLM Review Drafting (Anthropic API Key)
ANTHROPIC_API_KEY=your-anthropic-key
